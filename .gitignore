# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local
.env.local

# --- Meeradraw: exclude heavy AI test/comparison assets from the repo ---
# Phase-2 A/B stills (reference / generated). Keep the folder via .gitkeep.
/public/_phase2ab/*.png
/public/_phase2ab/*.jpg
/public/_phase2ab/*.jpeg
/public/_phase2ab/*.webp
/public/_phase2ab/**/*.png
/public/_phase2ab/**/*.jpg
/public/_phase2ab/**/*.jpeg
/public/_phase2ab/**/*.webp

# Full-resolution generation test dump (~8MB). The landing uses optimized copies.
/public/_gentest7/*.png
/public/_gentest7/_plan.json
bench-out/

# local agent/product workspaces
/.claude/
/_chariow_product/

# Firebase emulator logs
*-debug.log
firebase-debug.log
firestore-debug.log
/.swc
.forensic/
scripts/.*.tmp.ts
