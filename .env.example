# Firebase (client) — public web config from Firebase Console → Project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bookstudioai-8eadb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin (server) — required for Auth session cookies + Firestore Admin.
# From Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Providers — leave empty until you have real keys; keep MOCK_AI=true for mocks
# Texte: Groq (rapide) + OPENAI_API_KEY obligatoire en prod (failover JSON + vision QC).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# REQUIRED in production — vision QC + text failover when Groq fails / rate-limits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
FAL_KEY=
# Default image model: Ideogram V3 (line art). Override with FAL_PAGE_ENDPOINT / FAL_MODEL.
# Optional character-reference pages (Kontext). If unset, text locks only.
# FAL_REF_ENDPOINT=https://fal.run/fal-ai/flux-pro/kontext
# Controlled coloring pipeline (opt-in after a licensed LoRA benchmark).
# Uses fal-ai/flux-general with one portrait as reference-only guidance.
# FAL_CONTROLLED_COLORING_ENABLED=true
# FAL_CONTROLLED_PAGE_ENDPOINT=https://fal.run/fal-ai/flux-general
# FAL_COLORING_LORA_URL=https://huggingface.co/<licensed-model>/resolve/main/model.safetensors
# FAL_COLORING_LORA_SCALE=0.8
# FAL_IDENTITY_REFERENCE_STRENGTH=0.55
# FAL_IDENTITY_REFERENCE_END=0.8
# FAL_CONTROLLED_STEPS=30
# FAL_CONTROLLED_GUIDANCE=3.5
# PRINT_LINE_THRESHOLD=205
# FAL_INFERENCE_STEPS=28
# FAL_GUIDANCE_SCALE=3.5
# PAGE_GEN_CONCURRENCY=3
# SHEET_MAX_ATTEMPTS=3
# VISION_QC_TIMEOUT_MS=25000
# Quality re-rolls (keep low — each re-roll costs fal time).
# FAL_QUALITY_REROLLS=2
# VISION_QC_REROLLS=1
# VISION_QC=false
MOCK_AI=true

# Optional web research (story grounding for real people / topics).
# Priority: TAVILY_API_KEY → SERPER_API_KEY → DuckDuckGo Instant Answer (no key).
TAVILY_API_KEY=
SERPER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chariow (marketplace licenses — source of truth for access)
CHARIOW_API_KEY=
CHARIOW_API_BASE=https://api.chariow.com/v1
# Shared secret for Pulse auth (HMAC x-chariow-signature and/or ?token=)
CHARIOW_WEBHOOK_SECRET=
# Required in production when CHARIOW_API_KEY is set (fail-closed product scoping).
# Meeradraw access product id (e.g. prd_…).
CHARIOW_PRODUCT_ID=
CHARIOW_PRODUCT_SLUG=
# Optional: signs the HTTP-only post-purchase cookie (__md_purchase).
# Falls back to CHARIOW_WEBHOOK_SECRET then CRON_SECRET when unset.
PURCHASE_CONTEXT_SECRET=
# Optional cache for license revalidation (ms). Default 10 minutes.
# LICENSE_CACHE_TTL_MS=600000
# Public storefront link (landing + /license "Acheter sur Chariow")
NEXT_PUBLIC_CHARIOW_STORE_URL=
# Chariow product redirect URL to configure in the dashboard:
#   {NEXT_PUBLIC_APP_URL}/ouvrir-mon-acces?sale={sale_id}
# Pulse URL:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/chariow?token={CHARIOW_WEBHOOK_SECRET}

# Cron (Vercel Cron Authorization: Bearer <secret>) — required in production.
CRON_SECRET=

# Dev-only gen-test harness (disabled in production unless set).
# DEV_GENTEST_SECRET=

# Admin / owner emails — comma-separated. These accounts bypass Chariow
# (full studio access, no license key). Match Firebase Auth email exactly.
# Example: ADMIN_EMAILS=owner@example.com,cofounder@example.com
ADMIN_EMAILS=

# Generation tuning
# PAGE_GEN_CONCURRENCY=3
# SHEET_MAX_ATTEMPTS=3

# Vercel Workflow — Pro/Enterprise: allow steps up to 30 min (beta)
# Set in Vercel project env, then redeploy:
# VERCEL_ENABLE_WORKFLOW_EXTENDED_MAX_DURATION=1
