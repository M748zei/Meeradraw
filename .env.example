# ── Supabase (auth Google + portefeuille du hub digiafrik) ────────────────────
# Projet hub : arijliuqbprqgqztuseh (tables hub_wallets / hub_transactions /
# hub_tarifs / griot_recits, fonctions hub_debit_self / hub_refund_self).
NEXT_PUBLIC_SUPABASE_URL=https://arijliuqbprqgqztuseh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Fournisseurs texte (Groq d'abord, OpenAI en secours — les deux en prod) ───
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_AI=true

# Recherche web optionnelle (ancrage factuel des récits).
# Priorité : TAVILY_API_KEY → SERPER_API_KEY → DuckDuckGo (sans clé).
TAVILY_API_KEY=
SERPER_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lien boutique (achat de crédits sur le hub)
NEXT_PUBLIC_HUB_STORE_URL=

# ── Firebase — conservé en RÉFÉRENCE uniquement (bascule popup→redirect iOS) ──
# L'auth active de Griot est Supabase ; ces clés ne sont plus requises.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Moteur d'images (fal.ai + vision QC) — RESTAURÉ : changement de produit ──
FAL_KEY=
# Default image model: Ideogram V3 (line art). Override with FAL_PAGE_ENDPOINT / FAL_MODEL.
# FAL_REF_ENDPOINT=https://fal.run/fal-ai/flux-pro/kontext
# FAL_PAGE_ENDPOINT=
# FAL_REF_GUIDANCE=
# FAL_INFERENCE_STEPS=28
# FAL_GUIDANCE_SCALE=3.5
# FAL_QUALITY_REROLLS=2
# PAGE_GEN_CONCURRENCY=3
# SHEET_MAX_ATTEMPTS=3
# PRINT_LINE_THRESHOLD=205
# VISION_QC=false
# VISION_QC_REROLLS=1
# VISION_QC_TIMEOUT_MS=25000
OPENAI_VISION_MODEL=gpt-4o-mini
