# ── Supabase (auth Google + portefeuille du hub digiafrik) ────────────────────
# Projet hub : arijliuqbprqgqztuseh (tables hub_wallets / hub_transactions /
# hub_tarifs / griot_recits, fonctions hub_debit_self / hub_refund_self).
NEXT_PUBLIC_SUPABASE_URL=https://arijliuqbprqgqztuseh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Fournisseurs texte (Groq d'abord, OpenAI en secours — les deux en prod) ───
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_AI=true

# Recherche web optionnelle (ancrage factuel des récits).
# Priorité : TAVILY_API_KEY → SERPER_API_KEY → DuckDuckGo (sans clé).
TAVILY_API_KEY=
SERPER_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lien boutique (achat de crédits sur le hub)
NEXT_PUBLIC_HUB_STORE_URL=

# ── Firebase — conservé en RÉFÉRENCE uniquement (bascule popup→redirect iOS) ──
# L'auth active de Griot est Supabase ; ces clés ne sont plus requises.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
